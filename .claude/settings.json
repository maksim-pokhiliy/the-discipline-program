{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "node .claude/hooks/format-lint-changed.mjs",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "node .claude/hooks/prod-guard.mjs",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "node .claude/hooks/load-active-initiative.mjs",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
