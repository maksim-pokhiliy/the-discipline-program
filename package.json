{
  "name": "the-discipline-program",
  "private": true,
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "test": "cross-env SKIP_ENV_VALIDATION=1 vitest run",
    "test:watch": "cross-env SKIP_ENV_VALIDATION=1 vitest",
    "check-types": "turbo run check-types",
    "dep:check": "depcruise --config .dependency-cruiser.cjs --no-progress --output-type err packages apps",
    "dep:graph": "node scripts/dep-graph.mjs",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:seed": "pnpm --filter @repo/api-server db:seed",
    "postinstall": "turbo run db:generate",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^16.10.0",
    "dotenv": "catalog:",
    "lefthook": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-sort-json": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
