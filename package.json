{
  "name": "the-discipline-program",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "analyze:admin": "pnpm --filter admin analyze",
    "analyze:marketing": "pnpm --filter marketing analyze",
    "analyze:platform": "pnpm --filter platform analyze",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "clean": "node scripts/clean.mjs",
    "db:generate": "pnpm --filter @repo/api-server db:generate",
    "db:push": "pnpm --filter @repo/api-server db:push",
    "db:reset": "pnpm --filter @repo/api-server db:reset",
    "db:seed": "pnpm --filter @repo/api-server db:seed",
    "dep:check": "depcruise --config .dependency-cruiser.cjs --no-progress --output-type err packages apps",
    "dep:graph": "node scripts/dep-graph.mjs",
    "dev": "turbo run dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:marketing": "pnpm --filter marketing dev",
    "dev:platform": "pnpm --filter platform dev",
    "dev:storybook": "pnpm --filter storybook dev",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "lint": "turbo run lint",
    "postinstall": "pnpm --filter @repo/api-server db:generate",
    "prepare": "husky",
    "setup": "pnpm install && pnpm db:generate && pnpm db:push && pnpm db:seed",
    "test": "cross-env SKIP_ENV_VALIDATION=1 vitest run",
    "test:coverage": "cross-env SKIP_ENV_VALIDATION=1 vitest run --coverage",
    "test:watch": "cross-env SKIP_ENV_VALIDATION=1 vitest"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@repo/eslint-config": "workspace:*",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "cross-env": "catalog:",
    "dependency-cruiser": "catalog:",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-sort-json": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.12": "^1.1.12",
      "brace-expansion@>=2 <2.0.2": "^2.0.2",
      "flatted@<3.4.2": "^3.4.2",
      "markdown-it": "^14.1.1",
      "minimatch@<3.1.2": "^3.1.2",
      "minimatch@>=9 <9.0.7": "^9.0.7",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4 <4.0.4": "^4.0.4"
    }
  }
}
