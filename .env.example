# ──────────────────────────────────────────────────────────────
# .env.example — all environment variables used by the monorepo
# ──────────────────────────────────────────────────────────────
#
# Copy this file to the appropriate location:
#   - apps/admin/.env.local        (admin app)
#   - apps/marketing/.env.local    (marketing app)
#   - apps/platform/.env.local     (platform app)
#   - packages/api-server/.env     (Prisma CLI + tests)
#
# See docs/DEPLOY.md for per-app usage details.
# All variables are validated at boot by @repo/env (Zod).

# ── Database (all apps) ──────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname"
# Optional — only for authoring migrations locally (`pnpm db:migrate` = prisma
# migrate dev). Point at a SEPARATE empty Neon branch; Prisma wipes it each run.
# Not needed for generate / migrate deploy / db:reset / CI / Vercel.
SHADOW_DATABASE_URL="postgresql://user:password@host:5432/dbname_shadow"

# ── Auth (admin + platform only) ─────────────────────────────
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ── Public URLs (all apps) ───────────────────────────────────
# Self-URL of the current app (each app sets its own port)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Marketing URL — used for revalidation callbacks + SEO canonicals
NEXT_PUBLIC_MARKETING_URL="http://localhost:3000"
# Platform URL — used by admin when building invite links (must point to the platform app)
NEXT_PUBLIC_PLATFORM_URL="http://localhost:3001"

# ── Blob storage (admin + platform — file uploads) ───────────
# Provision a personal store at Vercel Dashboard → Storage → Create Blob Store,
# then copy the read/write token here. Each contributor should use their own store.
# Used by admin (CMS/blog/exercise images) and platform (coach avatar upload).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ── Rate limiting (optional — no-op adapter when unset) ──────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Off Vercel only: number of trusted reverse proxies in front of the app.
# The client IP is read from that hop of X-Forwarded-For (counted from the right).
# Leave unset when no trusted proxy overwrites X-Forwarded-For — the leftmost
# value is attacker-controlled and is never trusted as a rate-limit identity.
RATE_LIMIT_TRUSTED_PROXY_HOPS=

# ── Error tracking / Sentry (optional — no-op when unset) ────
NEXT_PUBLIC_SENTRY_DSN=
# Only required for source-map upload at build time:
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Transactional email (invites, password resets, lead notifications) ──
# Resend API key — server-only, never exposed to client
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Sender address used by Resend for transactional email
EMAIL_FROM=no-reply@example.com
# Optional reply-to address; falls back to EMAIL_FROM when unset
EMAIL_REPLY_TO=
# Invite token lifetime in hours (default: 72)
INVITE_TOKEN_TTL_HOURS=72

# ── Mobile publish (legacy connector) ──
# generate with: openssl rand -base64 32
MOBILE_PUBLISH_ENCRYPTION_KEY=
LEGACY_MOBILE_API_BASE_URL=https://legacy.example.com

# ── Build / CI overrides (not needed for local dev) ──────────
# SKIP_ENV_VALIDATION="1"
# VERCEL_GIT_COMMIT_SHA is auto-injected by Vercel
