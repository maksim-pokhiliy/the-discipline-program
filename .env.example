# ──────────────────────────────────────────────────────────────
# .env.example — all environment variables used by the monorepo
# ──────────────────────────────────────────────────────────────
#
# Copy this file to the appropriate location:
#   - apps/admin/.env.local        (admin app)
#   - apps/marketing/.env.local    (marketing app)
#   - apps/platform/.env.local     (platform app)
#   - packages/api-server/.env     (Prisma CLI + tests)
#
# See docs/DEPLOY.md for per-app usage details.
# All variables are validated at boot by @repo/env (Zod).

# ── Database (all apps) ──────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ── Auth (admin + platform only) ─────────────────────────────
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ── Public URLs (all apps) ───────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_MARKETING_URL="http://localhost:3001"

# ── Blob storage (admin only — file uploads) ─────────────────
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ── Build / CI overrides (not needed for local dev) ──────────
# SKIP_ENV_VALIDATION="1"
# VERCEL_GIT_COMMIT_SHA is auto-injected by Vercel
