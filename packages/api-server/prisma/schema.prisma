generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

model User {
  id                       String                   @id @default(cuid())
  email                    String                   @unique
  emailVerified            DateTime?
  name                     String?
  image                    String?
  password                 String?
  role                     Role                     @default(ATHLETE)
  tokenVersion             Int                      @default(0)
  timezone                 String                   @default("UTC")
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  deletedAt                DateTime?
  athleteProfile           AthleteProfile?
  coachProfile             CoachProfile?
  subscription             Subscription?
  transactions             Transaction[]
  trainingPlansCreated     TrainingPlan[]           @relation("PlanCreator")
  workoutSessions          WorkoutSession[]
  personalRecords          PersonalRecord[]
  coachNotes               CoachNote[]
  actionItems              CoachActionItem[]        @relation("ActionItemAthlete")
  inviteTokensReceived     UserInviteToken[]        @relation("UserInviteTokens")
  inviteTokensIssued       UserInviteToken[]        @relation("UserInviteTokensCreatedBy")
  athleteAssignments       CoachAthleteAssignment[] @relation("AthleteAssignments")
  planEnrollmentsAsAthlete PlanEnrollment[]         @relation("EnrollmentAthlete")
  planEnrollmentsCreated   PlanEnrollment[]         @relation("EnrollmentEnrolledBy")

  @@index([createdAt])
  @@index([deletedAt])
  @@index([name])
  @@index([email])
  @@index([role, deletedAt])
  @@map("users")
}

model AthleteProfile {
  id           String       @id @default(cuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender       Gender?
  heightCm     Int?
  weightKg     Decimal?     @db.Decimal(5, 2)
  healthStatus HealthStatus @default(HEALTHY)
  healthNote   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([createdAt])
  @@map("app_athlete_profiles")
}

model CoachProfile {
  id                      String                   @id @default(cuid())
  userId                  String                   @unique
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                     String?
  coachNotes              CoachNote[]
  actionItems             CoachActionItem[]
  coachAthleteAssignments CoachAthleteAssignment[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?

  @@index([createdAt])
  @@index([deletedAt])
  @@map("app_coach_profiles")
}

model CoachAthleteAssignment {
  id        String       @id @default(cuid())
  coachId   String
  coach     CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   User         @relation("AthleteAssignments", fields: [athleteId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([coachId, athleteId])
  @@index([coachId])
  @@index([athleteId])
  @@map("app_coach_athlete_assignments")
}

enum Role {
  ATHLETE
  COACH
  HEAD_COACH
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

model Product {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  description     String
  features        String[]
  stripeProductId String?   @unique
  isFeatured      Boolean   @default(false)
  isActive        Boolean   @default(true)
  prices          Price[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([createdAt, title])
  @@index([deletedAt])
  @@index([isActive])
  @@index([isFeatured])
  @@map("app_products")
}

model Price {
  id            String         @id @default(cuid())
  productId     String
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  amountCents   Int
  currency      Currency       @default(USD)
  interval      PriceInterval  @default(MONTHLY)
  stripePriceId String?        @unique
  isActive      Boolean        @default(true)
  subscriptions Subscription[]

  @@index([productId, isActive])
  @@map("app_prices")
}

enum Currency {
  USD
  EUR
  UAH
}

enum PriceInterval {
  MONTHLY
  YEARLY
  ONE_TIME
}

model Subscription {
  id                 String             @id
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  priceId            String
  price              Price              @relation(fields: [priceId], references: [id], onDelete: Restrict)
  status             SubscriptionStatus
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  graceEndsAt        DateTime?
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  transactions       Transaction[]

  @@index([createdAt])
  @@index([status])
  @@index([priceId])
  @@map("app_subscriptions")
}

model Transaction {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amountCents    Int
  currency       Currency
  status         TransactionStatus
  providerTxId   String            @unique
  idempotencyKey String            @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([createdAt])
  @@index([userId, status])
  @@index([subscriptionId])
  @@map("app_transactions")
}

model RequestIdempotency {
  id                 String   @id @default(cuid())
  key                String
  scope              String
  route              String
  method             String
  requestFingerprint String
  responseStatus     Int
  responseBody       Json
  responseHeaders    Json
  expiresAt          DateTime
  createdAt          DateTime @default(now())

  @@unique([key, scope, route])
  @@index([expiresAt])
  @@map("app_request_idempotency")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum TrainingPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SchemeArchetypeKind {
  NONE
  SETS_REPS
  COUNT_UP
  COUNT_DOWN
  INTERVAL_LOOP
  EMOM_LOOP
  TIME_BOXED
  LADDER
  DISTANCE
}

enum WorkoutSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  SKIPPED
}

enum RxStatus {
  RX
  SCALED
  SUBSTITUTED
  MODIFIED
}

enum MovementPattern {
  SQUAT
  HINGE
  PUSH_VERTICAL
  PUSH_HORIZONTAL
  PULL_VERTICAL
  PULL_HORIZONTAL
  LUNGE
  CARRY
  ROTATION
  CORE_FLEXION
  CORE_EXTENSION
  CORE_ANTI
  CARDIO_RUN
  CARDIO_BIKE
  CARDIO_ROW
  CARDIO_OTHER
  GYMNASTIC_HOLD
  GYMNASTIC_INVERTED
  EXPLOSIVE
  COMBO
}

enum PrKind {
  ONE_REP_MAX
  N_REP_MAX
  MAX_REPS_UNBROKEN
  MAX_REPS_TOTAL
  BEST_TIME_FOR_X
  MAX_DISTANCE_IN_T
  MAX_CALORIES_IN_T
  MAX_LOAD_FOR_REPS
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  REMOVED
}

model TrainingPlan {
  id          String             @id @default(cuid())
  creatorId   String
  creator     User               @relation("PlanCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  status      TrainingPlanStatus @default(DRAFT)
  name        String
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  days        PlanDay[]
  enrollments PlanEnrollment[]

  @@index([creatorId])
  @@index([status])
  @@index([deletedAt])
  @@map("lms_training_plans")
}

model WorkoutSession {
  id                String               @id @default(cuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  planSessionId     String?
  planSession       PlanSession?         @relation(fields: [planSessionId], references: [id], onDelete: SetNull)
  scheduledDate     DateTime?            @db.Date
  startedAt         DateTime
  completedAt       DateTime?
  durationSec       Int?
  status            WorkoutSessionStatus @default(IN_PROGRESS)
  perceivedExertion Int?
  mood              String?
  notes             String?
  completionRatio   Decimal?             @db.Decimal(3, 2)
  blockSessions     BlockSession[]

  @@index([userId, startedAt])
  @@index([userId, completedAt])
  @@index([userId, scheduledDate])
  @@index([planSessionId])
  @@map("lms_workout_sessions")
}

model BlockSession {
  id                   String              @id @default(cuid())
  workoutSessionId     String
  workoutSession       WorkoutSession      @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  order                Int
  blockNames           String[]
  weight               Int
  archetypeKind        SchemeArchetypeKind
  schemeParamsSnapshot Json
  startedAt            DateTime?
  completedAt          DateTime?
  durationSec          Int?
  rxStatus             RxStatus            @default(RX)
  resultPrimary        Json?
  notes                String?
  exerciseLogs         ExerciseLog[]

  @@index([workoutSessionId, order])
  @@map("lms_block_sessions")
}

model ExerciseLog {
  id                   String       @id @default(cuid())
  blockSessionId       String
  blockSession         BlockSession @relation(fields: [blockSessionId], references: [id], onDelete: Cascade)
  order                Int
  exerciseSnapshot     Json
  rxStatus             RxStatus     @default(RX)
  substituteExerciseId String?
  notes                String?
  setLogs              SetLog[]

  @@index([blockSessionId, order])
  @@map("lms_exercise_logs")
}

model SetLog {
  id            String      @id @default(cuid())
  exerciseLogId String
  exerciseLog   ExerciseLog @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)
  order         Int
  prescribed    Json
  actual        Json
  failed        Boolean     @default(false)
  notes         String?
  completedAt   DateTime?

  @@index([exerciseLogId, order])
  @@map("lms_set_logs")
}

model PersonalRecord {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           PrKind
  value          Decimal  @db.Decimal(10, 2)
  unit           String
  context        Json
  achievedAt     DateTime
  sourceSetLogId String?

  @@index([userId, achievedAt])
  @@map("lms_personal_records")
}

model Exercise {
  id              String          @id @default(cuid())
  name            String          @unique @db.Citext
  urls            String[]        @default([])
  primaryMovement MovementPattern
  benchmarkPrKind PrKind?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  planItems       PlanItem[]

  @@index([deletedAt])
  @@index([primaryMovement])
  @@map("lms_exercises")
}

model BlockType {
  id            String             @id @default(cuid())
  name          String             @unique @db.Citext
  description   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?
  blockTypeRefs PlanBlockTypeRef[]

  @@index([deletedAt])
  @@map("lms_block_types")
}

model SchemeType {
  id            String              @id @default(cuid())
  name          String              @unique @db.Citext
  archetypeKind SchemeArchetypeKind
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?
  planBlocks    PlanBlock[]

  @@index([deletedAt])
  @@index([archetypeKind])
  @@map("lms_scheme_types")
}

model DayType {
  id        String    @id @default(cuid())
  name      String    @unique @db.Citext
  color     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  planDays  PlanDay[]

  @@index([deletedAt])
  @@map("lms_day_types")
}

model PlanDay {
  id        String        @id @default(cuid())
  planId    String
  plan      TrainingPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  date      DateTime      @db.Date
  dayTypeId String?
  dayType   DayType?      @relation(fields: [dayTypeId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  sessions  PlanSession[]

  @@unique([planId, date])
  @@index([planId, date])
  @@index([dayTypeId])
  @@map("lms_plan_days")
}

model PlanSession {
  id              String           @id @default(cuid())
  dayId           String
  day             PlanDay          @relation(fields: [dayId], references: [id], onDelete: Cascade)
  order           Int
  label           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  blocks          PlanBlock[]
  workoutSessions WorkoutSession[]

  @@index([dayId, order])
  @@map("lms_plan_sessions")
}

model PlanBlock {
  id            String             @id @default(cuid())
  sessionId     String
  session       PlanSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  order         Int
  schemeTypeId  String
  schemeType    SchemeType         @relation(fields: [schemeTypeId], references: [id], onDelete: Restrict)
  schemeParams  Json
  modifiers     Json?
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  blockTypeRefs PlanBlockTypeRef[]
  items         PlanItem[]

  @@index([sessionId, order])
  @@index([schemeTypeId])
  @@map("lms_plan_blocks")
}

model PlanBlockTypeRef {
  id          String    @id @default(cuid())
  blockId     String
  block       PlanBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  blockTypeId String
  blockType   BlockType @relation(fields: [blockTypeId], references: [id], onDelete: Restrict)
  order       Int       @default(0)

  @@unique([blockId, blockTypeId])
  @@index([blockId, order])
  @@index([blockTypeId])
  @@map("lms_plan_block_type_refs")
}

model PlanItem {
  id           String    @id @default(cuid())
  blockId      String
  block        PlanBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  order        Int
  exerciseId   String
  exercise     Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  prescription Json
  alternatives Json?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([blockId, order])
  @@index([exerciseId])
  @@map("lms_plan_items")
}

model PlanEnrollment {
  id              String           @id @default(cuid())
  planId          String
  plan            TrainingPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  athleteId       String
  athlete         User             @relation("EnrollmentAthlete", fields: [athleteId], references: [id], onDelete: Cascade)
  enrolledById    String
  enrolledBy      User             @relation("EnrollmentEnrolledBy", fields: [enrolledById], references: [id], onDelete: Restrict)
  boardedAt       DateTime         @db.Date
  status          EnrollmentStatus @default(ACTIVE)
  statusChangedAt DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  @@index([planId, status])
  @@index([athleteId, status])
  @@index([enrolledById])
  @@index([deletedAt])
  @@map("lms_plan_enrollments")
}

enum HealthStatus {
  HEALTHY
  INJURED
  RESTRICTED
}

enum ActionItemType {
  MISSED_WORKOUTS
  HEALTH_REPORT
}

enum ActionItemStatus {
  OPEN
  RESOLVED
}

enum ActionItemResolveReason {
  AUTO_CONDITION_CLEARED
  AUTO_ASSIGNMENT_ENDED
  MANUAL_CONTACTED
}

model CoachActionItem {
  id            String                   @id @default(cuid())
  coachId       String
  coach         CoachProfile             @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athleteId     String
  athlete       User                     @relation("ActionItemAthlete", fields: [athleteId], references: [id], onDelete: Cascade)
  type          ActionItemType
  severity      ActionItemSeverity
  status        ActionItemStatus         @default(OPEN)
  message       String
  metadata      Json?
  resolvedAt    DateTime?
  resolveReason ActionItemResolveReason?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([coachId, status])
  @@index([coachId, status, athleteId])
  @@index([coachId, status, resolvedAt])
  @@index([athleteId])
  @@index([createdAt])
  @@map("app_coach_action_items")
}

enum ActionItemSeverity {
  INFO
  WARNING
  CRITICAL
}

model CoachNote {
  id        String       @id @default(cuid())
  coachId   String
  coach     CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   User         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  content   String       @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([coachId, athleteId])
  @@index([coachId, createdAt])
  @@index([athleteId])
  @@index([createdAt])
  @@map("app_coach_notes")
}

model MarketingPage {
  id        String                 @id @default(cuid())
  slug      String                 @unique
  title     String
  seoTitle  String?
  seoDesc   String?
  sections  MarketingPageSection[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@map("marketing_pages")
}

model MarketingPageSection {
  id        String        @id @default(cuid())
  pageSlug  String
  page      MarketingPage @relation(fields: [pageSlug], references: [slug], onDelete: Cascade)
  section   String
  data      Json
  isActive  Boolean       @default(true)
  updatedAt DateTime      @updatedAt

  @@unique([pageSlug, section])
  @@index([pageSlug, isActive])
  @@map("marketing_page_sections")
}

model MarketingBlogPost {
  id          String                @id @default(cuid())
  slug        String                @unique
  title       String
  excerpt     String?
  content     String                @db.Text
  coverImage  String?
  authorName  String
  category    MarketingBlogCategory @default(UNCATEGORIZED)
  tags        String[]
  readTime    Int?
  publishedAt DateTime?
  isPublished Boolean               @default(false)
  isFeatured  Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  deletedAt   DateTime?

  @@index([createdAt, title])
  @@index([deletedAt])
  @@index([isPublished, publishedAt])
  @@index([isPublished, category, publishedAt])
  @@index([category])
  @@index([isFeatured])
  @@map("marketing_blog_posts")
}

enum MarketingBlogCategory {
  UNCATEGORIZED
  FITNESS
  NUTRITION
  MINDSET
  TRAINING
  RECOVERY
}

model MarketingReview {
  id           String    @id @default(cuid())
  authorName   String
  authorRole   String?
  authorAvatar String?
  text         String
  rating       Int       @default(5)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([createdAt])
  @@index([deletedAt])
  @@index([isActive])
  @@map("marketing_reviews")
}

enum ContactSubmissionStatus {
  NEW
  IN_PROGRESS
  REPLIED
  CLOSED
}

model MarketingContactSubmission {
  id        String                  @id @default(cuid())
  name      String?
  contact   String?
  program   String?
  message   String                  @db.Text
  status    ContactSubmissionStatus @default(NEW)
  notes     String?                 @db.Text
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  deletedAt DateTime?

  @@index([createdAt])
  @@index([deletedAt])
  @@index([status])
  @@map("marketing_contact_submissions")
}

model UserInviteToken {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation("UserInviteTokens", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String    @unique
  expiresAt        DateTime
  consumedAt       DateTime?
  createdByAdminId String
  createdBy        User      @relation("UserInviteTokensCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  createdAt        DateTime  @default(now())

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@index([createdByAdminId])
  @@map("app_user_invite_tokens")
}
