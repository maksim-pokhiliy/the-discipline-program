generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  emailVerified   DateTime?
  name            String?
  image           String?
  password        String?
  role            Role            @default(USER)
  timezone        String          @default("UTC")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  athleteProfile  AthleteProfile?
  coachProfile    CoachProfile?
  subscription    Subscription?
  transactions    Transaction[]
  workoutLogs     WorkoutLog[]
  planEnrollments PlanEnrollment[]
  userBenchmarks  UserBenchmark[]
  coachNotes      CoachNote[]
  actionItems     CoachActionItem[] @relation("ActionItemAthlete")
  accounts        Account[]
  sessions        Session[]

  @@index([createdAt])
  @@index([deletedAt])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model AthleteProfile {
  id           String       @id @default(cuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender       Gender?
  heightCm     Int?
  weightKg     Decimal?     @db.Decimal(5, 2)
  healthStatus HealthStatus @default(HEALTHY)
  healthNote   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([createdAt])
  @@map("app_athlete_profiles")
}

model CoachProfile {
  id           String         @id @default(cuid())
  userId       String         @unique
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio          String?
  plans        TrainingPlan[]
  coachNotes   CoachNote[]
  actionItems  CoachActionItem[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  @@index([createdAt])
  @@index([deletedAt])
  @@map("app_coach_profiles")
}

enum Role {
  USER
  COACH
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

model Product {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  description     String
  features        String[]
  trainingPlanId  String?
  trainingPlan    TrainingPlan? @relation(fields: [trainingPlanId], references: [id], onDelete: SetNull)
  stripeProductId String?      @unique
  isFeatured      Boolean   @default(false)
  isActive        Boolean   @default(true)
  prices          Price[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([createdAt])
  @@index([deletedAt])
  @@index([isActive])
  @@map("app_products")
}

model Price {
  id            String         @id @default(cuid())
  productId     String
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  amountCents   Int
  currency      Currency       @default(USD)
  interval      PriceInterval  @default(MONTHLY)
  stripePriceId String?        @unique
  isActive      Boolean        @default(true)
  subscriptions Subscription[]

  @@index([productId, isActive])
  @@map("app_prices")
}

enum Currency {
  USD
  EUR
  UAH
}

enum PriceInterval {
  MONTHLY
  YEARLY
  ONE_TIME
}

model Subscription {
  id                 String             @id
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  priceId            String
  price              Price              @relation(fields: [priceId], references: [id])
  status             SubscriptionStatus
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  graceEndsAt        DateTime?
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([createdAt])
  @@index([status])
  @@map("app_subscriptions")
}

model Transaction {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  subscriptionId String?
  amountCents    Int
  currency       Currency
  status         TransactionStatus
  providerTxId   String            @unique
  idempotencyKey String?           @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([createdAt])
  @@index([userId, status])
  @@map("app_transactions")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model TrainingPlan {
  id          String             @id @default(cuid())
  coachId     String
  coach       CoachProfile       @relation(fields: [coachId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      TrainingPlanStatus @default(DRAFT)
  workouts    Workout[]
  enrollments PlanEnrollment[]
  products    Product[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  @@index([createdAt])
  @@index([deletedAt])
  @@index([status])
  @@map("app_training_plans")
}

model Workout {
  id            String         @id @default(cuid())
  planId        String
  plan          TrainingPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  scheduledDate DateTime? @db.Date
  title         String         @default("")
  description   String?
  content       String?        @db.Text
  sortOrder     Int            @default(0)
  isArchived    Boolean        @default(false)
  logs          WorkoutLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  @@index([planId, scheduledDate])
  @@index([planId])
  @@index([scheduledDate])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("app_workouts")
}

model WorkoutLog {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutId   String
  workout     Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  date        DateTime     @default(now())
  notes       String?
  isRx        Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([userId, workoutId])
  @@index([createdAt])
  @@index([userId])
  @@index([workoutId])
  @@map("app_workout_logs")
}

enum TrainingPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum HealthStatus {
  HEALTHY
  INJURED
  RESTRICTED
}

enum ActionItemType {
  MISSED_WORKOUTS
  NEW_NO_START
  HEALTH_REPORT
}

enum ActionItemStatus {
  OPEN
  RESOLVED
}

enum ActionItemResolveReason {
  AUTO_CONDITION_CLEARED
  AUTO_ENROLLMENT_ENDED
  MANUAL_CONTACTED
}

model CoachActionItem {
  id            String                    @id @default(cuid())
  coachId       String
  coach         CoachProfile              @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athleteId     String
  athlete       User                      @relation("ActionItemAthlete", fields: [athleteId], references: [id], onDelete: Cascade)
  type          ActionItemType
  severity      ActionItemSeverity
  status        ActionItemStatus          @default(OPEN)
  message       String
  metadata      Json?
  resolvedAt    DateTime?
  resolveReason ActionItemResolveReason?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([coachId, status])
  @@index([athleteId])
  @@index([createdAt])
  @@map("app_coach_action_items")
}

enum ActionItemSeverity {
  INFO
  WARNING
  CRITICAL
}

model CoachNote {
  id        String       @id @default(cuid())
  coachId   String
  coach     CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   User         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  content   String       @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([coachId, athleteId])
  @@index([createdAt])
  @@map("app_coach_notes")
}

enum PlanEnrollmentStatus {
  ACTIVE
  PAUSED
}

model PlanEnrollment {
  id             String               @id @default(cuid())
  trainingPlanId String
  trainingPlan   TrainingPlan         @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate      DateTime             @default(now())
  endDate        DateTime?
  status         PlanEnrollmentStatus @default(ACTIVE)
  createdAt      DateTime             @default(now())

  @@unique([trainingPlanId, userId])
  @@index([userId])
  @@index([status])
  @@index([trainingPlanId])
  @@map("app_plan_enrollments")
}

model BenchmarkDefinition {
  id             String          @id @default(cuid())
  name           String          @unique
  unit           String
  category       String?
  userBenchmarks UserBenchmark[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([category])
  @@map("app_benchmark_definitions")
}

model UserBenchmark {
  id                    String              @id @default(cuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  benchmarkDefinitionId String
  benchmarkDefinition   BenchmarkDefinition @relation(fields: [benchmarkDefinitionId], references: [id])
  value                 Decimal             @db.Decimal(10, 2)
  updatedAt             DateTime            @updatedAt

  @@unique([userId, benchmarkDefinitionId])
  @@index([benchmarkDefinitionId])
  @@map("app_user_benchmarks")
}

model MarketingPage {
  id        String                 @id @default(cuid())
  slug      String                 @unique
  title     String
  seoTitle  String?
  seoDesc   String?
  sections  MarketingPageSection[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@map("marketing_pages")
}

model MarketingPageSection {
  id        String        @id @default(cuid())
  pageSlug  String
  page      MarketingPage @relation(fields: [pageSlug], references: [slug], onDelete: Cascade)
  section   String
  data      Json
  isActive  Boolean       @default(true)
  updatedAt DateTime      @updatedAt

  @@unique([pageSlug, section])
  @@map("marketing_page_sections")
}

model MarketingBlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String    @db.Text
  coverImage  String?
  authorName  String
  category    String    @default("UNCATEGORIZED")
  tags        String[]
  readTime    Int?
  publishedAt DateTime?
  isPublished Boolean   @default(false)
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([createdAt])
  @@index([deletedAt])
  @@index([isPublished, publishedAt])
  @@map("marketing_blog_posts")
}


model MarketingReview {
  id           String    @id @default(cuid())
  authorName   String
  authorRole   String?
  authorAvatar String?
  text         String
  rating       Int       @default(5)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([createdAt])
  @@index([deletedAt])
  @@index([isActive])
  @@map("marketing_reviews")
}

enum ContactSubmissionStatus {
  NEW
  IN_PROGRESS
  REPLIED
  CLOSED
}

model MarketingContactSubmission {
  id        String                  @id @default(cuid())
  name      String?
  contact   String?
  program   String?
  message   String                  @db.Text
  status    ContactSubmissionStatus @default(NEW)
  notes     String?                 @db.Text
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  deletedAt DateTime?

  @@index([createdAt])
  @@index([deletedAt])
  @@index([status])
  @@map("marketing_contact_submissions")
}
