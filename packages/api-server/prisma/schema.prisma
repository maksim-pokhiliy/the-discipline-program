generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

model User {
  id                       String                   @id @default(cuid())
  email                    String                   @unique
  emailVerified            DateTime?
  name                     String?
  image                    String?
  password                 String?
  role                     Role                     @default(ATHLETE)
  tokenVersion             Int                      @default(0)
  timezone                 String                   @default("UTC")
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  deletedAt                DateTime?
  athleteProfile           AthleteProfile?
  coachProfile             CoachProfile?
  subscription             Subscription?
  transactions             Transaction[]
  trainingPlansCreated     TrainingPlan[]           @relation("PlanCreator")
  coachNotes               CoachNote[]
  actionItems              CoachActionItem[]        @relation("ActionItemAthlete")
  inviteTokensReceived     UserInviteToken[]        @relation("UserInviteTokens")
  inviteTokensIssued       UserInviteToken[]        @relation("UserInviteTokensCreatedBy")
  athleteAssignments       CoachAthleteAssignment[] @relation("AthleteAssignments")
  planEnrollmentsAsAthlete PlanEnrollment[]         @relation("EnrollmentAthlete")
  planEnrollmentsCreated   PlanEnrollment[]         @relation("EnrollmentEnrolledBy")
  oneRMRecords             OneRMRecord[]
  performedSessions        PerformedSession[]

  @@index([createdAt])
  @@index([deletedAt])
  @@index([name])
  @@index([email])
  @@index([role, deletedAt])
  @@map("users")
}

model AthleteProfile {
  id           String       @id @default(cuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender       Gender?
  heightCm     Int?
  weightKg     Decimal?     @db.Decimal(5, 2)
  healthStatus HealthStatus @default(HEALTHY)
  healthNote   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([createdAt])
  @@map("app_athlete_profiles")
}

model CoachProfile {
  id                      String                   @id @default(cuid())
  userId                  String                   @unique
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                     String?
  coachNotes              CoachNote[]
  actionItems             CoachActionItem[]
  coachAthleteAssignments CoachAthleteAssignment[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?

  @@index([createdAt])
  @@index([deletedAt])
  @@map("app_coach_profiles")
}

model CoachAthleteAssignment {
  id        String       @id @default(cuid())
  coachId   String
  coach     CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   User         @relation("AthleteAssignments", fields: [athleteId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([coachId, athleteId])
  @@index([coachId])
  @@index([athleteId])
  @@map("app_coach_athlete_assignments")
}

enum Role {
  ATHLETE
  COACH
  HEAD_COACH
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

model Product {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  description     String
  features        String[]
  stripeProductId String?   @unique
  isFeatured      Boolean   @default(false)
  isActive        Boolean   @default(true)
  prices          Price[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([createdAt, title])
  @@index([deletedAt])
  @@index([isActive])
  @@index([isFeatured])
  @@map("app_products")
}

model Price {
  id            String         @id @default(cuid())
  productId     String
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  amountCents   Int
  currency      Currency       @default(USD)
  interval      PriceInterval  @default(MONTHLY)
  stripePriceId String?        @unique
  isActive      Boolean        @default(true)
  subscriptions Subscription[]

  @@index([productId, isActive])
  @@map("app_prices")
}

enum Currency {
  USD
  EUR
  UAH
}

enum PriceInterval {
  MONTHLY
  YEARLY
  ONE_TIME
}

model Subscription {
  id                 String             @id
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  priceId            String
  price              Price              @relation(fields: [priceId], references: [id], onDelete: Restrict)
  status             SubscriptionStatus
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  graceEndsAt        DateTime?
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  transactions       Transaction[]

  @@index([createdAt])
  @@index([status])
  @@index([priceId])
  @@map("app_subscriptions")
}

model Transaction {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amountCents    Int
  currency       Currency
  status         TransactionStatus
  providerTxId   String            @unique
  idempotencyKey String            @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([createdAt])
  @@index([userId, status])
  @@index([subscriptionId])
  @@map("app_transactions")
}

model RequestIdempotency {
  id                 String   @id @default(cuid())
  key                String
  scope              String
  route              String
  method             String
  requestFingerprint String
  responseStatus     Int
  responseBody       Json
  responseHeaders    Json
  expiresAt          DateTime
  createdAt          DateTime @default(now())

  @@unique([key, scope, route])
  @@index([expiresAt])
  @@map("app_request_idempotency")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum TrainingPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  REMOVED
}

model TrainingPlan {
  id          String             @id @default(cuid())
  creatorId   String
  creator     User               @relation("PlanCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  status      TrainingPlanStatus @default(DRAFT)
  name        String
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  enrollments PlanEnrollment[]
  weeks       Week[]

  @@index([creatorId])
  @@index([status])
  @@index([deletedAt])
  @@map("lms_training_plans")
}

model PlanEnrollment {
  id              String           @id @default(cuid())
  planId          String
  plan            TrainingPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  athleteId       String
  athlete         User             @relation("EnrollmentAthlete", fields: [athleteId], references: [id], onDelete: Cascade)
  enrolledById    String
  enrolledBy      User             @relation("EnrollmentEnrolledBy", fields: [enrolledById], references: [id], onDelete: Restrict)
  boardedAt       DateTime         @db.Date
  status          EnrollmentStatus @default(ACTIVE)
  statusChangedAt DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  @@index([planId, status])
  @@index([athleteId, status])
  @@index([enrolledById])
  @@index([deletedAt])
  @@map("lms_plan_enrollments")
}

enum HealthStatus {
  HEALTHY
  INJURED
  RESTRICTED
}

enum ActionItemType {
  MISSED_WORKOUTS
  HEALTH_REPORT
}

enum ActionItemStatus {
  OPEN
  RESOLVED
}

enum ActionItemResolveReason {
  AUTO_CONDITION_CLEARED
  AUTO_ASSIGNMENT_ENDED
  MANUAL_CONTACTED
}

model CoachActionItem {
  id            String                   @id @default(cuid())
  coachId       String
  coach         CoachProfile             @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athleteId     String
  athlete       User                     @relation("ActionItemAthlete", fields: [athleteId], references: [id], onDelete: Cascade)
  type          ActionItemType
  severity      ActionItemSeverity
  status        ActionItemStatus         @default(OPEN)
  message       String
  metadata      Json?
  resolvedAt    DateTime?
  resolveReason ActionItemResolveReason?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([coachId, status])
  @@index([coachId, status, athleteId])
  @@index([coachId, status, resolvedAt])
  @@index([athleteId])
  @@index([createdAt])
  @@map("app_coach_action_items")
}

enum ActionItemSeverity {
  INFO
  WARNING
  CRITICAL
}

model CoachNote {
  id        String       @id @default(cuid())
  coachId   String
  coach     CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   User         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  content   String       @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([coachId, athleteId])
  @@index([coachId, createdAt])
  @@index([athleteId])
  @@index([createdAt])
  @@map("app_coach_notes")
}

model MarketingPage {
  id        String                 @id @default(cuid())
  slug      String                 @unique
  title     String
  seoTitle  String?
  seoDesc   String?
  sections  MarketingPageSection[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@map("marketing_pages")
}

model MarketingPageSection {
  id        String        @id @default(cuid())
  pageSlug  String
  page      MarketingPage @relation(fields: [pageSlug], references: [slug], onDelete: Cascade)
  section   String
  data      Json
  isActive  Boolean       @default(true)
  updatedAt DateTime      @updatedAt

  @@unique([pageSlug, section])
  @@index([pageSlug, isActive])
  @@map("marketing_page_sections")
}

model MarketingBlogPost {
  id          String                @id @default(cuid())
  slug        String                @unique
  title       String
  excerpt     String?
  content     String                @db.Text
  coverImage  String?
  authorName  String
  category    MarketingBlogCategory @default(UNCATEGORIZED)
  tags        String[]
  readTime    Int?
  publishedAt DateTime?
  isPublished Boolean               @default(false)
  isFeatured  Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  deletedAt   DateTime?

  @@index([createdAt, title])
  @@index([deletedAt])
  @@index([isPublished, publishedAt])
  @@index([isPublished, category, publishedAt])
  @@index([category])
  @@index([isFeatured])
  @@map("marketing_blog_posts")
}

enum MarketingBlogCategory {
  UNCATEGORIZED
  FITNESS
  NUTRITION
  MINDSET
  TRAINING
  RECOVERY
}

model MarketingReview {
  id           String    @id @default(cuid())
  authorName   String
  authorRole   String?
  authorAvatar String?
  text         String
  rating       Int       @default(5)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([createdAt])
  @@index([deletedAt])
  @@index([isActive])
  @@map("marketing_reviews")
}

enum ContactSubmissionStatus {
  NEW
  IN_PROGRESS
  REPLIED
  CLOSED
}

model MarketingContactSubmission {
  id        String                  @id @default(cuid())
  name      String?
  contact   String?
  program   String?
  message   String                  @db.Text
  status    ContactSubmissionStatus @default(NEW)
  notes     String?                 @db.Text
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  deletedAt DateTime?

  @@index([createdAt])
  @@index([deletedAt])
  @@index([status])
  @@map("marketing_contact_submissions")
}

model UserInviteToken {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation("UserInviteTokens", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String    @unique
  expiresAt        DateTime
  consumedAt       DateTime?
  createdByAdminId String
  createdBy        User      @relation("UserInviteTokensCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  createdAt        DateTime  @default(now())

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@index([createdByAdminId])
  @@map("app_user_invite_tokens")
}

// === Training-domain (Phase 7 ratification, 2026-05-12) ===
// Source spec: analysis/artifacts/06-formalization/schema.prisma
// Ratified per D1-D4 — see implementation/PLANNING_STATE.md

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum Equipment {
  ASSAULT_BIKE
  ATLAS_STONE
  BAND
  BARBELL
  BODYWEIGHT
  BOX
  BOX_OR_SOFA
  DUMBBELL
  JUMP_ROPE
  KETTLEBELL
  MIXED
  PARALLEL_BARS
  RINGS
  ROW_ERG
  SKI_ERG
  SLED
  SOFA
  UNKNOWN
  YOKE
}

enum MovementType {
  SQUAT
  HINGE
  PRESS
  PULL
  LUNGE
  CARRY
  LOCOMOTION
  STATIC_HOLD
  ROTATIONAL
  CARDIO_FLOW
  CORE
  COMBINED_OLYMPIC
  RAISE
  EXTENSION
  UNKNOWN
}

enum CanonicalCompoundType {
  ATOMIC
  COMPOUND_PLUS
  COMPOSITE_NAMED
  PLACEHOLDER
  ALTERNATIVE_OR
}

enum SchemaKind {
  ATOMIC
  HEADERLESS
  NESTED
  NAMED
  COMPOSITE
}

enum RowKind {
  EXERCISE
  REST
  FOOTNOTE
  STANDALONE_LOAD
  STANDALONE_URL
  PLACEHOLDER
  INNER_LADDER_MARKER
  REP_DEFINITION
  REST_SLOT
}

enum ArchetypeFamily {
  ROUNDS_SETS
  LADDER
  TIME_CAP
  COMPOSITE_ROUNDS
  NESTED
  NAMED
  SINGLE_LINE_HEADERLESS
  FLAT_PARALLEL_HEADERLESS
  MODALITY_REFERENCE
}

enum Position {
  NEUTRAL_GRIP
  FROM_SOFA
  FROM_BOX
  FROM_BOX_OR_SOFA
  FROM_SOFA_BOX
  WITHOUT_BENCH
  WITHOUT_JUMP
  HOLD_FARM_CARRY
  HAND_ON_DB
  HANDS_ON_DB
  HAND_ON_DB_NEUTRAL_GRIP
}

enum OneRMRecordSource {
  MANUAL
  AUTO_INFERRED
  TESTED
}

enum AlternatingGroupRelation {
  ALTERNATING_SETS
}

enum AppLevel {
  DAY
  SESSION
  BLOCK
}

model Week {
  id        String   @id @default(cuid())
  planId    String
  startDate DateTime @db.Date
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  days Day[]

  @@unique([planId, startDate])
  @@index([planId, startDate])
  @@map("training_weeks")
}

model Day {
  id        String    @id @default(cuid())
  weekId    String
  dayOfWeek DayOfWeek
  labelId   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  week     Week      @relation(fields: [weekId], references: [id], onDelete: Cascade)
  label    Label?    @relation(fields: [labelId], references: [id], onDelete: Restrict)
  sessions Session[]

  @@unique([weekId, dayOfWeek])
  @@index([weekId, dayOfWeek])
  @@index([labelId])
  @@map("training_days")
}

model Session {
  id                    String   @id @default(cuid())
  dayId                 String
  order                 Int
  labelId               String?
  notes                 String?
  freezeLoadsAtCreation Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  day               Day                @relation(fields: [dayId], references: [id], onDelete: Cascade)
  label             Label?             @relation(fields: [labelId], references: [id], onDelete: Restrict)
  blocks            Block[]
  performedSessions PerformedSession[]

  @@index([dayId, order])
  @@index([labelId])
  @@map("training_sessions")
}

model Block {
  id        String   @id @default(cuid())
  sessionId String
  order     Int
  intensity Json?
  timeCap   Json?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session           Session                @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  labelAssignments  BlockLabelAssignment[]
  schemas           Schema[]
  alternatingGroups AlternatingGroup[]

  @@unique([sessionId, order])
  @@index([sessionId, order])
  @@map("training_blocks")
}

model BlockLabelAssignment {
  id      String @id @default(cuid())
  blockId String
  labelId String
  order   Int

  block Block @relation(fields: [blockId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Restrict)

  @@unique([blockId, labelId])
  @@index([blockId, order])
  @@index([labelId])
  @@map("training_block_label_assignments")
}

model Schema {
  id                 String     @id @default(cuid())
  blockId            String
  parentSchemaId     String?
  alternatingGroupId String?
  order              Int
  kind               SchemaKind?
  archetypeId        String?
  header             String?
  archetypeParams    Json?
  composition        Json?
  intensity          Json?
  trailingConnector  Json?
  notes              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  block            Block             @relation(fields: [blockId], references: [id], onDelete: Cascade)
  parentSchema     Schema?           @relation("SchemaSubSchemas", fields: [parentSchemaId], references: [id], onDelete: Cascade)
  subSchemas       Schema[]          @relation("SchemaSubSchemas")
  archetype        Archetype?        @relation(fields: [archetypeId], references: [id], onDelete: Restrict)
  alternatingGroup AlternatingGroup? @relation(fields: [alternatingGroupId], references: [id], onDelete: SetNull)
  rows             SchemaRow[]

  @@index([blockId, order])
  @@unique([parentSchemaId, order])
  @@index([parentSchemaId, order])
  @@index([archetypeId])
  @@index([alternatingGroupId])
  @@map("training_schemas")
}

model AlternatingGroup {
  id           String                   @id @default(cuid())
  blockId      String
  relationKind AlternatingGroupRelation
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  block   Block    @relation(fields: [blockId], references: [id], onDelete: Cascade)
  schemas Schema[]

  @@index([blockId])
  @@map("training_alternating_groups")
}

model SchemaRow {
  id          String    @id @default(cuid())
  schemaId    String
  order       Int
  rowKind     RowKind
  rowPayload  Json
  load        Json?
  reps        Json?
  side        Json?
  tempo       Json?
  position    Position?
  sequence    Json?
  intensity   Json?
  media       Json?
  compoundRep Json?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  schema                     Schema                      @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  performedExerciseInstances PerformedExerciseInstance[]

  @@unique([schemaId, order])
  @@index([schemaId, order])
  @@map("training_schema_rows")
}

model Exercise {
  id                       String                @id @default(cuid())
  canonicalName            String
  canonicalNameLower       String                @unique
  primaryEquipment         Equipment
  movementTypeTagPrimary   MovementType
  movementTypeTagSecondary MovementType?
  defaultDemoUrls          String[]
  canonicalCompoundType    CanonicalCompoundType
  placeholderFlag          Boolean               @default(false)
  movementFamily           String?
  defaultLoad              Json?
  aliases                  Json?
  notes                    String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  oneRMRecords OneRMRecord[]

  @@index([canonicalName])
  @@index([movementFamily])
  @@map("training_exercises")
}

model Label {
  id               String   @id @default(cuid())
  name             String
  nameLower        String   @unique
  applicableLevels Json
  notes            String?
  rest             Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  days             Day[]
  sessions         Session[]
  blockAssignments BlockLabelAssignment[]

  @@index([name])
  @@map("training_labels")
}

model Archetype {
  id                       String          @id @default(cuid())
  name                     String          @unique
  label                    String
  kind                     SchemaKind
  family                   ArchetypeFamily
  headerPatternDescription String
  bodyLayoutDescription    String
  archetypeParamsSchema    Json
  relatedArchetypes        Json
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  schemas Schema[]

  @@map("training_archetypes")
}

model OneRMRecord {
  id         String            @id @default(cuid())
  userId     String
  exerciseId String
  valueKg    Decimal           @db.Decimal(6, 2)
  recordedAt DateTime
  source     OneRMRecordSource

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([userId, exerciseId])
  @@index([exerciseId])
  @@index([userId])
  @@map("training_one_rm_records")
}

model PerformedSession {
  id           String    @id @default(cuid())
  sessionId    String
  userId       String
  startedAt    DateTime
  completedAt  DateTime?
  coachNotes   String?
  athleteNotes String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  session                    Session                     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user                       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  performedExerciseInstances PerformedExerciseInstance[]

  @@unique([sessionId, userId])
  @@index([userId])
  @@map("training_performed_sessions")
}

model PerformedExerciseInstance {
  id                 String   @id @default(cuid())
  performedSessionId String
  plannedSchemaRowId String
  actualLoad         Json
  actualReps         Json
  actualIntensity    Json?
  stageActuals       Json?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  performedSession PerformedSession @relation(fields: [performedSessionId], references: [id], onDelete: Cascade)
  plannedSchemaRow SchemaRow        @relation(fields: [plannedSchemaRowId], references: [id], onDelete: Restrict)

  @@index([performedSessionId])
  @@index([plannedSchemaRowId])
  @@map("training_performed_exercise_instances")
}
