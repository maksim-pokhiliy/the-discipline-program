generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                   @id @default(cuid())
  email                String                   @unique
  emailVerified        DateTime?
  name                 String?
  image                String?
  password             String?
  role                 Role                     @default(ATHLETE)
  tokenVersion         Int                      @default(0)
  timezone             String                   @default("UTC")
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  deletedAt            DateTime?
  athleteProfile       AthleteProfile?
  coachProfile         CoachProfile?
  subscription         Subscription?
  transactions         Transaction[]
  trainingPlansCreated TrainingPlan[]           @relation("PlanCreator")
  planCoachAssignments PlanCoachAssignment[]    @relation("PlanCoachAssigneeUser")
  planEnrollments      PlanEnrollment[]
  workoutSessions      WorkoutSession[]
  personalRecords      PersonalRecord[]
  benchmarks           Benchmark[]
  weeklyVolumes        WeeklyVolume[]
  exerciseLibraryItems ExerciseLibraryItem[]    @relation("ExerciseOwner")
  ownedBlockKinds      BlockKind[]              @relation("BlockKindOwner")
  ownedSchemeTemplates SchemeTemplate[]         @relation("SchemeTemplateOwner")
  ownedBlockTemplates  BlockTemplate[]          @relation("BlockTemplateOwner")
  ownedSessionTemplates SessionTemplate[]       @relation("SessionTemplateOwner")
  ownedWeekTemplates   WeekTemplate[]           @relation("WeekTemplateOwner")
  coachNotes           CoachNote[]
  actionItems          CoachActionItem[]        @relation("ActionItemAthlete")
  inviteTokensReceived UserInviteToken[]        @relation("UserInviteTokens")
  inviteTokensIssued   UserInviteToken[]        @relation("UserInviteTokensCreatedBy")
  athleteAssignments   CoachAthleteAssignment[] @relation("AthleteAssignments")

  @@index([createdAt])
  @@index([deletedAt])
  @@index([name])
  @@index([email])
  @@index([role, deletedAt])
  @@map("users")
}

model AthleteProfile {
  id           String       @id @default(cuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender       Gender?
  heightCm     Int?
  weightKg     Decimal?     @db.Decimal(5, 2)
  healthStatus HealthStatus @default(HEALTHY)
  healthNote   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([createdAt])
  @@map("app_athlete_profiles")
}

model CoachProfile {
  id                      String                   @id @default(cuid())
  userId                  String                   @unique
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                     String?
  coachNotes              CoachNote[]
  actionItems             CoachActionItem[]
  coachAthleteAssignments CoachAthleteAssignment[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?

  @@index([createdAt])
  @@index([deletedAt])
  @@map("app_coach_profiles")
}

model CoachAthleteAssignment {
  id        String       @id @default(cuid())
  coachId   String
  coach     CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   User         @relation("AthleteAssignments", fields: [athleteId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([coachId, athleteId])
  @@index([coachId])
  @@index([athleteId])
  @@map("app_coach_athlete_assignments")
}

enum Role {
  ATHLETE
  COACH
  HEAD_COACH
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

model Product {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  description     String
  features        String[]
  trainingPlanId  String?
  trainingPlan    TrainingPlan? @relation(fields: [trainingPlanId], references: [id], onDelete: SetNull)
  stripeProductId String?       @unique
  isFeatured      Boolean       @default(false)
  isActive        Boolean       @default(true)
  prices          Price[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  @@index([createdAt, title])
  @@index([deletedAt])
  @@index([isActive])
  @@index([trainingPlanId])
  @@index([isFeatured])
  @@map("app_products")
}

model Price {
  id            String         @id @default(cuid())
  productId     String
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  amountCents   Int
  currency      Currency       @default(USD)
  interval      PriceInterval  @default(MONTHLY)
  stripePriceId String?        @unique
  isActive      Boolean        @default(true)
  subscriptions Subscription[]

  @@index([productId, isActive])
  @@map("app_prices")
}

enum Currency {
  USD
  EUR
  UAH
}

enum PriceInterval {
  MONTHLY
  YEARLY
  ONE_TIME
}

model Subscription {
  id                 String             @id
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  priceId            String
  price              Price              @relation(fields: [priceId], references: [id], onDelete: Restrict)
  status             SubscriptionStatus
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  graceEndsAt        DateTime?
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  transactions       Transaction[]

  @@index([createdAt])
  @@index([status])
  @@index([priceId])
  @@map("app_subscriptions")
}

model Transaction {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amountCents    Int
  currency       Currency
  status         TransactionStatus
  providerTxId   String            @unique
  idempotencyKey String            @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([createdAt])
  @@index([userId, status])
  @@index([subscriptionId])
  @@map("app_transactions")
}

model RequestIdempotency {
  id                 String   @id @default(cuid())
  key                String
  scope              String
  route              String
  method             String
  requestFingerprint String
  responseStatus     Int
  responseBody       Json
  responseHeaders    Json
  expiresAt          DateTime
  createdAt          DateTime @default(now())

  @@unique([key, scope, route])
  @@index([expiresAt])
  @@map("app_request_idempotency")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum TrainingPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PlanEnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum DayKind {
  TRAINING
  REST
  YOGA
  OFF
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum BlockStatus {
  ACTIVE
  SUSPENDED
}

enum SchemeArchetypeKind {
  NONE
  COUNT_UP
  COUNT_DOWN
  INTERVAL_LOOP
  EMOM_LOOP
  TIME_BOXED
}

enum LibraryScope {
  SYSTEM
  COACH
}

enum SideMode {
  BILATERAL
  EACH_ARM
  EACH_LEG
  ASYMMETRIC_HOLD
  UNILATERAL_ALTERNATING
}

enum WorkoutSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  SKIPPED
}

enum RxStatus {
  RX
  SCALED
  SUBSTITUTED
  MODIFIED
}

enum MovementPattern {
  SQUAT
  HINGE
  PUSH_VERTICAL
  PUSH_HORIZONTAL
  PULL_VERTICAL
  PULL_HORIZONTAL
  LUNGE
  CARRY
  ROTATION
  CORE_FLEXION
  CORE_EXTENSION
  CORE_ANTI
  CARDIO_RUN
  CARDIO_BIKE
  CARDIO_ROW
  CARDIO_OTHER
  GYMNASTIC_HOLD
  GYMNASTIC_INVERTED
  EXPLOSIVE
  COMBO
}

enum Modality {
  BARBELL
  DUMBBELL
  KETTLEBELL
  BODYWEIGHT
  CARDIO
  BANDED
  MIXED
  MACHINE
}

enum BodyPart {
  SHOULDERS
  CHEST
  BACK
  ARMS_BICEPS
  ARMS_TRICEPS
  CORE
  GLUTES
  HAMSTRINGS
  QUADS
  CALVES
  HIPS
  POSTERIOR_CHAIN
  FULL_BODY
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ELITE
}

enum PrKind {
  ONE_REP_MAX
  N_REP_MAX
  MAX_REPS_UNBROKEN
  MAX_REPS_TOTAL
  BEST_TIME_FOR_X
  MAX_DISTANCE_IN_T
  MAX_CALORIES_IN_T
  MAX_LOAD_FOR_REPS
}

enum BenchmarkSource {
  MANUAL
  DERIVED_FROM_LOG
}

model TrainingPlan {
  id               String                @id @default(cuid())
  creatorId        String
  creator          User                  @relation("PlanCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  status           TrainingPlanStatus    @default(DRAFT)
  name             String
  description      String?
  licensable       Boolean               @default(false)
  originalPlanId   String?
  weeks            Week[]
  enrollments      PlanEnrollment[]
  coachAssignments PlanCoachAssignment[]
  products         Product[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?

  @@index([creatorId])
  @@index([status])
  @@index([deletedAt])
  @@map("lms_training_plans")
}

model PlanCoachAssignment {
  id        String       @id @default(cuid())
  planId    String
  plan      TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  coachId   String
  coach     User         @relation("PlanCoachAssigneeUser", fields: [coachId], references: [id], onDelete: Cascade)
  canEdit   Boolean      @default(true)
  grantedBy String
  grantedAt DateTime     @default(now())

  @@unique([planId, coachId])
  @@index([coachId])
  @@map("lms_plan_coach_assignments")
}

model Week {
  id      String       @id @default(cuid())
  planId  String
  plan    TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  index   Int
  label   String?
  notes   String?
  version Int          @default(1)
  days    Day[]

  @@unique([planId, index])
  @@map("lms_weeks")
}

model Day {
  id        String       @id @default(cuid())
  weekId    String
  week      Week         @relation(fields: [weekId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  kind      DayKind      @default(TRAINING)
  notes     String?
  version   Int          @default(1)
  sessions  LmsSession[]

  @@unique([weekId, dayOfWeek])
  @@map("lms_days")
}

model LmsSession {
  id      String  @id @default(cuid())
  dayId   String
  day     Day     @relation(fields: [dayId], references: [id], onDelete: Cascade)
  order   Int
  label   String?
  notes   String?
  version Int     @default(1)
  blocks  Block[]

  @@unique([dayId, order])
  @@map("lms_sessions")
}

model Block {
  id            String         @id @default(cuid())
  sessionId     String
  session       LmsSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  order         Int
  kindId        String
  kind          BlockKind      @relation(fields: [kindId], references: [id], onDelete: Restrict)
  title         String?
  status        BlockStatus    @default(ACTIVE)
  weight        Int            @default(1)
  notes         String?
  version       Int            @default(1)
  segments      BlockSegment[]
  blockSessions BlockSession[]

  @@index([sessionId, order])
  @@index([kindId])
  @@map("lms_blocks")
}

model BlockSegment {
  id               String              @id @default(cuid())
  blockId          String
  block            Block               @relation(fields: [blockId], references: [id], onDelete: Cascade)
  order            Int
  label            String?
  archetypeKind    SchemeArchetypeKind
  schemeParams     Json
  schemeTemplateId String?
  schemeTemplate   SchemeTemplate?     @relation(fields: [schemeTemplateId], references: [id], onDelete: SetNull)
  restConfig       Json?
  version          Int                 @default(1)
  setGroups        SetGroup[]

  @@index([blockId, order])
  @@index([schemeTemplateId])
  @@map("lms_block_segments")
}

model SetGroup {
  id         String          @id @default(cuid())
  segmentId  String
  segment    BlockSegment    @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  order      Int
  label      String?
  restConfig Json?
  entries    ExerciseEntry[]

  @@index([segmentId, order])
  @@map("lms_set_groups")
}

model ExerciseEntry {
  id               String              @id @default(cuid())
  setGroupId       String
  setGroup         SetGroup            @relation(fields: [setGroupId], references: [id], onDelete: Cascade)
  order            Int
  exerciseId       String
  exercise         ExerciseLibraryItem @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  exerciseSnapshot Json
  prescription     Json
  alternatives     Json                @default("[]")
  externalUrl      String?
  notes            String?
  version          Int                 @default(1)

  @@index([setGroupId, order])
  @@index([exerciseId])
  @@map("lms_exercise_entries")
}

model BlockKind {
  id                   String               @id @default(cuid())
  scope                LibraryScope         @default(SYSTEM)
  ownerId              String?
  owner                User?                @relation("BlockKindOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name                 String
  description          String?
  iconKey              String?
  defaultWeight        Int                  @default(1)
  defaultArchetypeKind SchemeArchetypeKind?
  analyticsCategory    String?
  blocks               Block[]
  version              Int                  @default(1)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?

  @@unique([scope, ownerId, name])
  @@index([scope, ownerId])
  @@index([deletedAt])
  @@map("lms_block_kinds")
}

model SchemeTemplate {
  id            String              @id @default(cuid())
  scope         LibraryScope        @default(SYSTEM)
  ownerId       String?
  owner         User?               @relation("SchemeTemplateOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  archetypeKind SchemeArchetypeKind
  defaultParams Json
  segments      BlockSegment[]
  version       Int                 @default(1)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?

  @@unique([scope, ownerId, name])
  @@index([scope, ownerId])
  @@index([deletedAt])
  @@map("lms_scheme_templates")
}

model BlockTemplate {
  id          String       @id @default(cuid())
  scope       LibraryScope @default(SYSTEM)
  ownerId     String?
  owner       User?        @relation("BlockTemplateOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  payload     Json
  version     Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@unique([scope, ownerId, name])
  @@index([scope, ownerId])
  @@index([deletedAt])
  @@map("lms_block_templates")
}

model SessionTemplate {
  id          String       @id @default(cuid())
  scope       LibraryScope @default(SYSTEM)
  ownerId     String?
  owner       User?        @relation("SessionTemplateOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  payload     Json
  version     Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@unique([scope, ownerId, name])
  @@index([scope, ownerId])
  @@index([deletedAt])
  @@map("lms_session_templates")
}

model WeekTemplate {
  id          String       @id @default(cuid())
  scope       LibraryScope @default(SYSTEM)
  ownerId     String?
  owner       User?        @relation("WeekTemplateOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  payload     Json
  version     Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@unique([scope, ownerId, name])
  @@index([scope, ownerId])
  @@index([deletedAt])
  @@map("lms_week_templates")
}

model ExerciseLibraryItem {
  id                 String                @id @default(cuid())
  scope              LibraryScope          @default(SYSTEM)
  ownerId            String?
  owner              User?                 @relation("ExerciseOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  nameAliases        String[]              @default([])
  description        String?
  primaryMovement    MovementPattern
  modality           Modality
  equipment          String[]              @default([])
  primaryBodyParts   BodyPart[]            @default([])
  secondaryBodyParts BodyPart[]            @default([])
  skillLevel         SkillLevel            @default(BEGINNER)
  defaultMetrics     Json
  demoVideoUrl       String?
  demoImageUrl       String?
  parentId           String?
  parent             ExerciseLibraryItem?  @relation("Variants", fields: [parentId], references: [id], onDelete: SetNull)
  variants           ExerciseLibraryItem[] @relation("Variants")
  isBenchmark        Boolean               @default(false)
  version            Int                   @default(1)
  supersedesId       String?
  supersedes         ExerciseLibraryItem?  @relation("Superseded", fields: [supersedesId], references: [id], onDelete: SetNull)
  successors         ExerciseLibraryItem[] @relation("Superseded")
  isDeprecated       Boolean               @default(false)
  entries            ExerciseEntry[]
  exerciseLogs       ExerciseLog[]
  benchmarks         Benchmark[]
  personalRecords    PersonalRecord[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?

  @@unique([scope, ownerId, name])
  @@index([scope, ownerId])
  @@index([primaryMovement])
  @@index([modality])
  @@index([isBenchmark])
  @@index([parentId])
  @@index([supersedesId])
  @@index([deletedAt])
  @@map("lms_exercise_library")
}

model PlanEnrollment {
  id                 String               @id @default(cuid())
  planId             String
  plan               TrainingPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId             String
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAtWeekIndex Int
  startedOnDate      DateTime             @db.Date
  status             PlanEnrollmentStatus @default(ACTIVE)
  endedOnDate        DateTime?            @db.Date
  workoutSessions    WorkoutSession[]
  overrides          PlanOverride[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([planId, userId])
  @@index([userId])
  @@index([planId])
  @@index([status, planId])
  @@index([userId, status])
  @@map("lms_plan_enrollments")
}

model PlanOverride {
  id                String         @id @default(cuid())
  enrollmentId      String
  enrollment        PlanEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  scope             String
  scopeId           String
  kind              String
  payload           Json
  startsOnWeekIndex Int?
  endsOnWeekIndex   Int?
  createdAt         DateTime       @default(now())

  @@index([enrollmentId, scope, scopeId])
  @@map("lms_plan_overrides")
}

model WorkoutSession {
  id                String               @id @default(cuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollmentId      String?
  enrollment        PlanEnrollment?      @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  sourceDayId       String?
  scheduledFor      DateTime?
  startedAt         DateTime
  completedAt       DateTime?
  durationSec       Int?
  status            WorkoutSessionStatus @default(IN_PROGRESS)
  perceivedExertion Int?
  mood              String?
  notes             String?
  completionRatio   Decimal?             @db.Decimal(3, 2)
  blockSessions     BlockSession[]

  @@index([userId, startedAt])
  @@index([enrollmentId, startedAt])
  @@map("lms_workout_sessions")
}

model BlockSession {
  id                   String              @id @default(cuid())
  workoutSessionId     String
  workoutSession       WorkoutSession      @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  sourceBlockId        String?
  sourceBlock          Block?              @relation(fields: [sourceBlockId], references: [id], onDelete: SetNull)
  order                Int
  kindName             String
  weight               Int
  archetypeKind        SchemeArchetypeKind
  schemeParamsSnapshot Json
  startedAt            DateTime?
  completedAt          DateTime?
  durationSec          Int?
  rxStatus             RxStatus            @default(RX)
  resultPrimary        Json?
  notes                String?
  exerciseLogs         ExerciseLog[]

  @@index([workoutSessionId, order])
  @@index([sourceBlockId])
  @@map("lms_block_sessions")
}

model ExerciseLog {
  id                   String              @id @default(cuid())
  blockSessionId       String
  blockSession         BlockSession        @relation(fields: [blockSessionId], references: [id], onDelete: Cascade)
  sourceEntryId        String?
  order                Int
  exerciseId           String
  exercise             ExerciseLibraryItem @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  exerciseSnapshot     Json
  rxStatus             RxStatus            @default(RX)
  substituteExerciseId String?
  notes                String?
  setLogs              SetLog[]

  @@index([blockSessionId, order])
  @@index([exerciseId])
  @@map("lms_exercise_logs")
}

model SetLog {
  id            String      @id @default(cuid())
  exerciseLogId String
  exerciseLog   ExerciseLog @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)
  order         Int
  prescribed    Json
  actual        Json
  failed        Boolean     @default(false)
  notes         String?
  completedAt   DateTime?

  @@index([exerciseLogId, order])
  @@map("lms_set_logs")
}

model PersonalRecord {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId     String
  exercise       ExerciseLibraryItem @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  kind           PrKind
  value          Decimal             @db.Decimal(10, 2)
  unit           String
  context        Json
  achievedAt     DateTime
  sourceSetLogId String?

  @@unique([userId, exerciseId, kind])
  @@index([userId, achievedAt])
  @@map("lms_personal_records")
}

model WeeklyVolume {
  id                         String   @id @default(cuid())
  userId                     String
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStartDate              DateTime @db.Date
  totalTonnageKg             Decimal  @db.Decimal(10, 2)
  tonnageByPattern           Json
  totalDurationSec           Int
  workoutsScheduled          Int
  workoutsFullyCompleted     Int
  workoutsPartiallyCompleted Int
  workoutsMissed             Int
  workoutsRx                 Int
  workoutsScaled             Int
  recomputedAt               DateTime

  @@unique([userId, weekStartDate])
  @@index([userId, weekStartDate])
  @@map("lms_weekly_volumes")
}

model Benchmark {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   ExerciseLibraryItem @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  kind       PrKind
  value      Decimal             @db.Decimal(10, 2)
  unit       String
  source     BenchmarkSource     @default(MANUAL)
  setBy      String
  setAt      DateTime            @default(now())
  notes      String?

  @@unique([userId, exerciseId, kind])
  @@index([userId])
  @@map("lms_benchmarks")
}

enum HealthStatus {
  HEALTHY
  INJURED
  RESTRICTED
}

enum ActionItemType {
  MISSED_WORKOUTS
  NEW_NO_START
  HEALTH_REPORT
}

enum ActionItemStatus {
  OPEN
  RESOLVED
}

enum ActionItemResolveReason {
  AUTO_CONDITION_CLEARED
  AUTO_ENROLLMENT_ENDED
  MANUAL_CONTACTED
}

model CoachActionItem {
  id            String                   @id @default(cuid())
  coachId       String
  coach         CoachProfile             @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athleteId     String
  athlete       User                     @relation("ActionItemAthlete", fields: [athleteId], references: [id], onDelete: Cascade)
  type          ActionItemType
  severity      ActionItemSeverity
  status        ActionItemStatus         @default(OPEN)
  message       String
  metadata      Json?
  resolvedAt    DateTime?
  resolveReason ActionItemResolveReason?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([coachId, status])
  @@index([coachId, status, athleteId])
  @@index([coachId, status, resolvedAt])
  @@index([athleteId])
  @@index([createdAt])
  @@map("app_coach_action_items")
}

enum ActionItemSeverity {
  INFO
  WARNING
  CRITICAL
}

model CoachNote {
  id        String       @id @default(cuid())
  coachId   String
  coach     CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   User         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  content   String       @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([coachId, athleteId])
  @@index([coachId, createdAt])
  @@index([athleteId])
  @@index([createdAt])
  @@map("app_coach_notes")
}

model MarketingPage {
  id        String                 @id @default(cuid())
  slug      String                 @unique
  title     String
  seoTitle  String?
  seoDesc   String?
  sections  MarketingPageSection[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@map("marketing_pages")
}

model MarketingPageSection {
  id        String        @id @default(cuid())
  pageSlug  String
  page      MarketingPage @relation(fields: [pageSlug], references: [slug], onDelete: Cascade)
  section   String
  data      Json
  isActive  Boolean       @default(true)
  updatedAt DateTime      @updatedAt

  @@unique([pageSlug, section])
  @@index([pageSlug, isActive])
  @@map("marketing_page_sections")
}

model MarketingBlogPost {
  id          String                @id @default(cuid())
  slug        String                @unique
  title       String
  excerpt     String?
  content     String                @db.Text
  coverImage  String?
  authorName  String
  category    MarketingBlogCategory @default(UNCATEGORIZED)
  tags        String[]
  readTime    Int?
  publishedAt DateTime?
  isPublished Boolean               @default(false)
  isFeatured  Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  deletedAt   DateTime?

  @@index([createdAt, title])
  @@index([deletedAt])
  @@index([isPublished, publishedAt])
  @@index([isPublished, category, publishedAt])
  @@index([category])
  @@index([isFeatured])
  @@map("marketing_blog_posts")
}

enum MarketingBlogCategory {
  UNCATEGORIZED
  FITNESS
  NUTRITION
  MINDSET
  TRAINING
  RECOVERY
}

model MarketingReview {
  id           String    @id @default(cuid())
  authorName   String
  authorRole   String?
  authorAvatar String?
  text         String
  rating       Int       @default(5)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([createdAt])
  @@index([deletedAt])
  @@index([isActive])
  @@map("marketing_reviews")
}

enum ContactSubmissionStatus {
  NEW
  IN_PROGRESS
  REPLIED
  CLOSED
}

model MarketingContactSubmission {
  id        String                  @id @default(cuid())
  name      String?
  contact   String?
  program   String?
  message   String                  @db.Text
  status    ContactSubmissionStatus @default(NEW)
  notes     String?                 @db.Text
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  deletedAt DateTime?

  @@index([createdAt])
  @@index([deletedAt])
  @@index([status])
  @@map("marketing_contact_submissions")
}

model UserInviteToken {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation("UserInviteTokens", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String    @unique
  expiresAt        DateTime
  consumedAt       DateTime?
  createdByAdminId String
  createdBy        User      @relation("UserInviteTokensCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  createdAt        DateTime  @default(now())

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@index([createdByAdminId])
  @@map("app_user_invite_tokens")
}
