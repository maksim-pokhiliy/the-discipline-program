generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                   @id @default(cuid())
  email                String                   @unique
  emailVerified        DateTime?
  name                 String?
  image                String?
  password             String?
  role                 Role                     @default(ATHLETE)
  tokenVersion         Int                      @default(0)
  timezone             String                   @default("UTC")
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  deletedAt            DateTime?
  athleteProfile       AthleteProfile?
  coachProfile         CoachProfile?
  subscription         Subscription?
  transactions         Transaction[]
  workoutLogs          WorkoutLog[]
  planEnrollments      PlanEnrollment[]
  userBenchmarks       UserBenchmark[]
  coachNotes           CoachNote[]
  actionItems          CoachActionItem[]        @relation("ActionItemAthlete")
  inviteTokensReceived UserInviteToken[]        @relation("UserInviteTokens")
  inviteTokensIssued   UserInviteToken[]        @relation("UserInviteTokensCreatedBy")
  athleteAssignments   CoachAthleteAssignment[] @relation("AthleteAssignments")
  exercisesAuthored    Exercise[]               @relation("ExerciseAuthor")
  exercisesReviewed    Exercise[]               @relation("ExerciseReviewer")
  accounts             Account[]
  sessions             Session[]

  @@index([createdAt])
  @@index([deletedAt])
  @@index([name])
  @@index([email])
  @@index([role, deletedAt])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model AthleteProfile {
  id           String       @id @default(cuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender       Gender?
  heightCm     Int?
  weightKg     Decimal?     @db.Decimal(5, 2)
  healthStatus HealthStatus @default(HEALTHY)
  healthNote   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([createdAt])
  @@map("app_athlete_profiles")
}

model CoachProfile {
  id                      String                   @id @default(cuid())
  userId                  String                   @unique
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                     String?
  plans                   TrainingPlan[]
  coachNotes              CoachNote[]
  actionItems             CoachActionItem[]
  coachAthleteAssignments CoachAthleteAssignment[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?

  @@index([createdAt])
  @@index([deletedAt])
  @@map("app_coach_profiles")
}

model CoachAthleteAssignment {
  id        String       @id @default(cuid())
  coachId   String
  coach     CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   User         @relation("AthleteAssignments", fields: [athleteId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([coachId, athleteId])
  @@index([coachId])
  @@index([athleteId])
  @@map("app_coach_athlete_assignments")
}

enum Role {
  ATHLETE
  COACH
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

model Product {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  description     String
  features        String[]
  trainingPlanId  String?
  trainingPlan    TrainingPlan? @relation(fields: [trainingPlanId], references: [id], onDelete: SetNull)
  stripeProductId String?       @unique
  isFeatured      Boolean       @default(false)
  isActive        Boolean       @default(true)
  prices          Price[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  @@index([createdAt, title])
  @@index([deletedAt])
  @@index([isActive])
  @@index([trainingPlanId])
  @@index([isFeatured])
  @@map("app_products")
}

model Price {
  id            String         @id @default(cuid())
  productId     String
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  amountCents   Int
  currency      Currency       @default(USD)
  interval      PriceInterval  @default(MONTHLY)
  stripePriceId String?        @unique
  isActive      Boolean        @default(true)
  subscriptions Subscription[]

  @@index([productId, isActive])
  @@map("app_prices")
}

enum Currency {
  USD
  EUR
  UAH
}

enum PriceInterval {
  MONTHLY
  YEARLY
  ONE_TIME
}

model Subscription {
  id                 String             @id
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  priceId            String
  price              Price              @relation(fields: [priceId], references: [id], onDelete: Restrict)
  status             SubscriptionStatus
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  graceEndsAt        DateTime?
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  transactions       Transaction[]

  @@index([createdAt])
  @@index([status])
  @@index([priceId])
  @@map("app_subscriptions")
}

model Transaction {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amountCents    Int
  currency       Currency
  status         TransactionStatus
  providerTxId   String            @unique
  idempotencyKey String            @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([createdAt])
  @@index([userId, status])
  @@index([subscriptionId])
  @@map("app_transactions")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model TrainingPlan {
  id          String             @id @default(cuid())
  coachId     String
  coach       CoachProfile       @relation(fields: [coachId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      TrainingPlanStatus @default(DRAFT)
  workouts    Workout[]
  enrollments PlanEnrollment[]
  products    Product[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  @@index([coachId])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([status])
  @@map("app_training_plans")
}

model Workout {
  id            String         @id @default(cuid())
  planId        String
  plan          TrainingPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  scheduledDate DateTime?      @db.Date
  title         String         @default("")
  description   String?
  contentDoc    Json?
  sortOrder     Int            @default(0)
  isArchived    Boolean        @default(false)
  blocks        WorkoutBlock[]
  logs          WorkoutLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  @@index([planId, scheduledDate])
  @@index([planId, isArchived])
  @@index([scheduledDate])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("app_workouts")
}

model WorkoutLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutId String
  workout   Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  notes     String?
  isRx      Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, workoutId])
  @@index([createdAt])
  @@index([userId])
  @@index([userId, date])
  @@index([workoutId])
  @@map("app_workout_logs")
}

enum TrainingPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum HealthStatus {
  HEALTHY
  INJURED
  RESTRICTED
}

enum ActionItemType {
  MISSED_WORKOUTS
  NEW_NO_START
  HEALTH_REPORT
}

enum ActionItemStatus {
  OPEN
  RESOLVED
}

enum ActionItemResolveReason {
  AUTO_CONDITION_CLEARED
  AUTO_ENROLLMENT_ENDED
  MANUAL_CONTACTED
}

model CoachActionItem {
  id            String                   @id @default(cuid())
  coachId       String
  coach         CoachProfile             @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athleteId     String
  athlete       User                     @relation("ActionItemAthlete", fields: [athleteId], references: [id], onDelete: Cascade)
  type          ActionItemType
  severity      ActionItemSeverity
  status        ActionItemStatus         @default(OPEN)
  message       String
  metadata      Json?
  resolvedAt    DateTime?
  resolveReason ActionItemResolveReason?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([coachId, status])
  @@index([coachId, status, athleteId])
  @@index([coachId, status, resolvedAt])
  @@index([athleteId])
  @@index([createdAt])
  @@map("app_coach_action_items")
}

enum ActionItemSeverity {
  INFO
  WARNING
  CRITICAL
}

model CoachNote {
  id        String       @id @default(cuid())
  coachId   String
  coach     CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   User         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  content   String       @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([coachId, athleteId])
  @@index([coachId, createdAt])
  @@index([athleteId])
  @@index([createdAt])
  @@map("app_coach_notes")
}

enum PlanEnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model PlanEnrollment {
  id             String               @id @default(cuid())
  trainingPlanId String
  trainingPlan   TrainingPlan         @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate      DateTime             @default(now())
  endDate        DateTime?
  status         PlanEnrollmentStatus @default(ACTIVE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([trainingPlanId, userId])
  @@index([userId])
  @@index([trainingPlanId])
  @@index([status, trainingPlanId])
  @@index([userId, status, trainingPlanId])
  @@map("app_plan_enrollments")
}

model BenchmarkDefinition {
  id             String          @id @default(cuid())
  name           String          @unique
  unit           String
  category       String?
  userBenchmarks UserBenchmark[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([category])
  @@map("app_benchmark_definitions")
}

model UserBenchmark {
  id                    String              @id @default(cuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  benchmarkDefinitionId String
  benchmarkDefinition   BenchmarkDefinition @relation(fields: [benchmarkDefinitionId], references: [id], onDelete: Restrict)
  value                 Decimal             @db.Decimal(10, 2)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([userId, benchmarkDefinitionId])
  @@index([userId])
  @@index([benchmarkDefinitionId])
  @@map("app_user_benchmarks")
}

model MarketingPage {
  id        String                 @id @default(cuid())
  slug      String                 @unique
  title     String
  seoTitle  String?
  seoDesc   String?
  sections  MarketingPageSection[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@map("marketing_pages")
}

model MarketingPageSection {
  id        String        @id @default(cuid())
  pageSlug  String
  page      MarketingPage @relation(fields: [pageSlug], references: [slug], onDelete: Cascade)
  section   String
  data      Json
  isActive  Boolean       @default(true)
  updatedAt DateTime      @updatedAt

  @@unique([pageSlug, section])
  @@index([pageSlug, isActive])
  @@map("marketing_page_sections")
}

model MarketingBlogPost {
  id          String                @id @default(cuid())
  slug        String                @unique
  title       String
  excerpt     String?
  content     String                @db.Text
  coverImage  String?
  authorName  String
  category    MarketingBlogCategory @default(UNCATEGORIZED)
  tags        String[]
  readTime    Int?
  publishedAt DateTime?
  isPublished Boolean               @default(false)
  isFeatured  Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  deletedAt   DateTime?

  @@index([createdAt, title])
  @@index([deletedAt])
  @@index([isPublished, publishedAt])
  @@index([isPublished, category, publishedAt])
  @@index([category])
  @@index([isFeatured])
  @@map("marketing_blog_posts")
}

enum MarketingBlogCategory {
  UNCATEGORIZED
  FITNESS
  NUTRITION
  MINDSET
  TRAINING
  RECOVERY
}

model MarketingReview {
  id           String    @id @default(cuid())
  authorName   String
  authorRole   String?
  authorAvatar String?
  text         String
  rating       Int       @default(5)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([createdAt])
  @@index([deletedAt])
  @@index([isActive])
  @@map("marketing_reviews")
}

enum ContactSubmissionStatus {
  NEW
  IN_PROGRESS
  REPLIED
  CLOSED
}

model MarketingContactSubmission {
  id        String                  @id @default(cuid())
  name      String?
  contact   String?
  program   String?
  message   String                  @db.Text
  status    ContactSubmissionStatus @default(NEW)
  notes     String?                 @db.Text
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  deletedAt DateTime?

  @@index([createdAt])
  @@index([deletedAt])
  @@index([status])
  @@map("marketing_contact_submissions")
}

model UserInviteToken {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation("UserInviteTokens", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String    @unique
  expiresAt        DateTime
  consumedAt       DateTime?
  createdByAdminId String
  createdBy        User      @relation("UserInviteTokensCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  createdAt        DateTime  @default(now())

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@map("app_user_invite_tokens")
}

enum ExerciseStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  MERGED
}

enum SchemeKind {
  STRAIGHT_SETS
  FOR_TIME
  AMRAP
  EMOM
  EVERY_X_MIN
  INTERVALS
  TIME_BLOCKS
}

enum WorkoutRepScheme {
  STRAIGHT
  LADDER
  PYRAMID
  REVERSE_LADDER
  CUSTOM
}

enum PrescriptionKind {
  PERCENT_OF_1RM
  KG
  RPE
  NONE
}

enum MeasurementUnit {
  REPS
  TIME_SEC
  DISTANCE_M
  CALORIES
}

model Exercise {
  id               String                 @id @default(cuid())
  canonicalName    String                 @db.VarChar(200)
  normalizedName   String                 @db.VarChar(200)
  aliases          String[]
  description      String?                @db.Text
  videoUrl         String?
  measurementUnits MeasurementUnit[]
  hasLoad          Boolean                @default(false)
  status           ExerciseStatus         @default(PENDING_REVIEW)
  mergedIntoId     String?
  mergedInto       Exercise?              @relation("ExerciseMerges", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  merges           Exercise[]             @relation("ExerciseMerges")
  createdByUserId  String
  createdBy        User                   @relation("ExerciseAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reviewedByUserId String?
  reviewedBy       User?                  @relation("ExerciseReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  reviewNotes      String?                @db.Text
  workoutRefs      WorkoutBlockExercise[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deletedAt        DateTime?

  @@unique([normalizedName, status], map: "uniq_exercise_active_name")
  @@index([status, canonicalName])
  @@index([createdByUserId])
  @@index([deletedAt])
  @@map("lib_exercises")
}

model Scheme {
  id             String         @id @default(cuid())
  slug           String         @unique @db.VarChar(100)
  name           String         @db.VarChar(100)
  kind           SchemeKind
  description    String?        @db.Text
  requiredParams String[]
  paramDefaults  Json
  active         Boolean        @default(true)
  sortOrder      Int            @default(0)
  workoutRefs    WorkoutBlock[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([kind])
  @@index([active, sortOrder])
  @@map("lib_schemes")
}

model BlockType {
  id          String         @id @default(cuid())
  slug        String         @unique @db.VarChar(100)
  name        String         @db.VarChar(100)
  description String?        @db.Text
  iconKey     String?
  colorKey    String?
  sortOrder   Int            @default(0)
  active      Boolean        @default(true)
  workoutRefs WorkoutBlock[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([active, sortOrder])
  @@map("lib_block_types")
}

model WorkoutBlock {
  id           String                 @id @default(cuid())
  workoutId    String
  workout      Workout                @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  blockTypeId  String
  blockType    BlockType              @relation(fields: [blockTypeId], references: [id], onDelete: Restrict)
  schemeId     String?
  scheme       Scheme?                @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  schemeKind   SchemeKind?
  schemeConfig Json?
  effortPct    Int?
  pace         String?
  note         String?                @db.Text
  sortOrder    Int                    @default(0)
  exercises    WorkoutBlockExercise[]
  emomSlots    EmomSlot[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([workoutId, sortOrder])
  @@index([blockTypeId])
  @@index([schemeId])
  @@map("app_workout_blocks")
}

model WorkoutBlockExercise {
  id           String           @id @default(cuid())
  blockId      String?
  block        WorkoutBlock?    @relation(fields: [blockId], references: [id], onDelete: Cascade)
  emomSlotId   String?
  emomSlot     EmomSlot?        @relation(fields: [emomSlotId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  repScheme    WorkoutRepScheme @default(STRAIGHT)
  repValues    Int[]
  sets         Int?
  prescription Json?
  restSec      Int?
  note         String?          @db.Text
  complexGroup String?
  complexOrder Int?
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([blockId, sortOrder])
  @@index([emomSlotId, sortOrder])
  @@index([exerciseId])
  @@map("app_workout_block_exercises")
}

model EmomSlot {
  id            String                 @id @default(cuid())
  blockId       String
  block         WorkoutBlock           @relation(fields: [blockId], references: [id], onDelete: Cascade)
  minuteInRound Int
  sortOrder     Int                    @default(0)
  note          String?                @db.Text
  exercises     WorkoutBlockExercise[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([blockId, minuteInRound])
  @@index([blockId, sortOrder])
  @@map("app_emom_slots")
}
