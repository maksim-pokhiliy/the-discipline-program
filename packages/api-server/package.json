{
  "name": "@repo/api-server",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    "./cms": "./src/endpoints/cms/index.ts",
    "./lms": "./src/endpoints/lms/index.ts",
    "./lms/exercise-library-item": "./src/endpoints/lms/exercise-library-item.ts",
    "./lms/block-kind": "./src/endpoints/lms/block-kind/index.ts",
    "./lms/scheme-template": "./src/endpoints/lms/scheme-template.ts",
    "./lms/block-template": "./src/endpoints/lms/block-template/index.ts",
    "./lms/session-template": "./src/endpoints/lms/session-template.ts",
    "./lms/week-template": "./src/endpoints/lms/week-template.ts",
    "./lms/apply-template": "./src/services/lms/apply-template/index.ts",
    "./lms/pr-evaluator": "./src/services/lms/pr-evaluator/index.ts",
    "./coaching": "./src/endpoints/coaching/index.ts",
    "./iam": "./src/endpoints/iam/index.ts",
    "./storage": "./src/endpoints/storage/index.ts",
    "./ops": "./src/endpoints/ops/index.ts",
    "./infrastructure/monitoring": "./src/infrastructure/monitoring/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --fix --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "prisma generate",
    "db:push:prisma": "prisma db push",
    "db:push": "prisma db push && tsx scripts/apply-sql-checks.ts",
    "db:reset:prisma": "prisma db push --force-reset",
    "db:reset": "prisma db push --force-reset && tsx scripts/apply-sql-checks.ts",
    "db:seed": "prisma db seed",
    "db:seed:pages": "tsx prisma/seed-pages.ts",
    "db:apply-checks": "tsx scripts/apply-sql-checks.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "catalog:",
    "@sentry/nextjs": "catalog:",
    "@repo/contracts": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/env": "workspace:*",
    "@repo/errors": "workspace:*",
    "@repo/shared": "workspace:*",
    "@vercel/blob": "catalog:",
    "bcryptjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "prisma": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
