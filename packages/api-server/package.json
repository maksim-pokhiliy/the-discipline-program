{
  "name": "@repo/api-server",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    "./cms": "./src/endpoints/cms/index.ts",
    "./lms": "./src/endpoints/lms/index.ts",
    "./coaching": "./src/endpoints/coaching/index.ts",
    "./iam": "./src/endpoints/iam/index.ts",
    "./storage": "./src/endpoints/storage/index.ts",
    "./ops": "./src/endpoints/ops/index.ts",
    "./infrastructure/monitoring": "./src/infrastructure/monitoring/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --fix --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:reset": "prisma db push --force-reset",
    "db:seed": "prisma db seed",
    "db:seed:pages": "tsx prisma/seed-pages.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "catalog:",
    "@sentry/nextjs": "catalog:",
    "@repo/contracts": "workspace:*",
    "@repo/env": "workspace:*",
    "@repo/errors": "workspace:*",
    "@repo/shared": "workspace:*",
    "@vercel/blob": "catalog:",
    "bcryptjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "prisma": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
